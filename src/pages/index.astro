---
import { Icon } from 'developer-icons/dist/icon';
import Layout from '../layouts/Layout.astro';
import { 
  TypeScript, 
  React as ReactIcon, 
  NextJs, 
  NodeJs, 
  Python, 
  PostgreSQL, 
  Supabase,
  Git, 
  NestJS
} from "developer-icons";
 
 
const stack = [
  { name: 'React / Next.js', Icon: ReactIcon },
  { name: 'React Native / Expo', Icon: ReactIcon },
  { name: 'TypeScript', Icon: TypeScript },
  { name: 'Node.js / Express', Icon: NodeJs },
  { name: 'FastAPI / Python', Icon: Python },
  { name: 'NestJS', Icon: NestJS},
  { name: 'PostgreSQL / MySQL', Icon: PostgreSQL },
  { name: 'Supabase / Firebase', Icon: Supabase },
  { name: 'Git / Scrum', Icon: Git }
];

const experience = [
	{
		id: 'sistema-llc',
		company: 'Element Sagety LLC',
		place: 'Cliente en EE.UU. · Remoto',
		role: 'FullStack Developer',
		period: 'Mar 2026 — Jun 2026',
		points: [
			'Sistema de gestión de facturación con Next.js y Firebase: seguimiento de pagos en tiempo real y reportes financieros.',
			'Autenticación con roles y permisos para proteger la información de la empresa.',
			'Landing Page con Astro, React y Tailwind CSS'
		],
		achievement: 'Reduje en 35% el tiempo de generación de reportes financieros.',
		tech: ['Next.js', 'React', 'Astro', 'Firebase', 'TypeScript', 'Tailwind'],
		isHighlight: true,
		url: 'https://www.elementsafetyllc.com/'
	},
	{
		id: 'sistema-dental',
		company: 'Odontologia Inturias',
		place: 'Cochabamba, Bolivia',
		role: 'FullStack Developer',
		period: 'Dic 2025 — Feb 2026',
		points: [
			'Sistema completo para clínica dental: historias clínicas, citas médicas y módulo de pagos.',
			'Arquitectura serverless con Next.js y Supabase para escalabilidad inmediata.'
		],
		achievement: 'Reduje en 90% el tiempo administrativo de recepción y optimicé la agenda de especialistas.',
		tech: ['Next.js', 'Supabase', 'Express', 'PostgreSQL'],
		isHighlight: true
	},
	{
		id: 'smaigo',
		company: 'Smaigo S.R.L',
		place: 'Cochabamba, Bolivia',
		role: 'FullStack / Mobile Developer',
		period: 'Ago 2025 — Feb 2026',
		points: [
			'App móvil en React Native con Redux para estado complejo y sincronización de datos en tiempo real.',
			'Backend con Firebase y Express; panel administrativo en Next.js aplicando Atomic Design.'
		],
		achievement: 'Mejore el rendimiento de la App en un 70% y implemente funcionalidades avanzadas.',
		tech: ['React Native', 'Redux', 'Firebase', 'Express', 'Next.js'],
		isHighlight: true,
		url: 'https://smaigo.com.bo/'
	},
	{
		id: 'zekiri',
		company: 'Zekiri',
		place: 'Cochabamba, Bolivia',
		role: 'FullStack Developer',
		period: 'Ago 2024 — Ago 2025',
		points: [
			'Lideré el frontend de múltiples proyectos con Next.js: arquitectura de componentes y flujo de datos.',
			'Trabajo en equipos ágiles bajo Scrum: planning, dailies y retrospectivas.'
		],
		achievement: 'Consultas ~30% más rápidas tras optimizar Supabase y Firebase.',
		tech: ['Next.js', 'Supabase', 'Firebase', 'TypeScript', 'Scrum'],
		isHighlight: false,
		url: 'https://zekiri.io/'

	}
];

const projects = [
		{
		title: 'Landing Page Element Safety LLC',
		description: 'Landing page para empresa de seguridad.',
		result: 'Mejor posicionamiento en buscadores y mayor visibilidad de la empresa.',
		tags: ['Astro', 'React', 'Tailwind'],
		demo: 'https://www.elementsafetyllc.com/',
		repo: 'https://github.com/cristhian2020/temporal-page'
	},
	{
		title: 'Sistema de Gestión Dental',
		description: 'Plataforma para clínica dental: historias clínicas, agenda de citas y pagos en un solo sistema.',
		result: 'Reducción del 40% en el tiempo administrativo de recepción.',
		tags: ['Next.js', 'Supabase'],
		demo: '#',
		repo: 'https://github.com/cristhian2020/Sistema_Dental_Clinico'
	},
	{
		title: 'Ecommerce GuitarLA',
		description: 'Tienda online con carrito de compras, catálogo dinámico y pasarela de pago.',
		result: 'Arquitectura headless escalable con contenido gestionado desde Strapi.',
		tags: ['Next.js', 'Strapi', 'TypeScript'],
		demo: 'https://effortless-souffle-8e9bd5.netlify.app/',
	},
	{
		title: 'Citas Veterinaria',
		description: 'Sistema de citas para clínica veterinaria, con historias clínicas, agenda de citas y pagos en un solo sistema.',
		result: 'Digitalización completa del registro manual.',
		tags: ['React', 'Firebase', 'Tailwind'],
		demo: 'https://eclectic-sherbet-469a12.netlify.app/',
		repo: 'https://github.com/cristhian2020/Citas-Veterinaria-React'
	}
];
---

<Layout title="Cristhian Rocha | Full Stack & Mobile Developer">
	<main class="shell">
		<section class="hero" id="inicio">
			<div class="hero-copy">
				<p class="tag">FULL STACK & MOBILE DEVELOPER</p>
				<h1>Arquitectura, código y producto en una sola ejecución.</h1>
				<p>
					Construyo aplicaciones web y móviles reales para clínicas, comercios y
					sistemas universitarios. Especializado en React, Next.js y React Native:
					de la estrategia del MVP al despliegue en producción.
				</p>
				<div class="actions">
					<a class="btn solid" href="#proyectos">Explorar proyectos</a>
					<a class="btn outline" href="#contacto">Agendar llamada</a>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="mini">Disponibilidad</p>
				<h2>Inmediata</h2>
				<ul>
					<li>2+ años construyendo producto real para clientes.</li>
					<li>Web + mobile: React, Next.js y React Native.</li>
					<li>Cochabamba, Bolivia · Remoto · Inglés B1.</li>
				</ul>
			</aside>
		</section>

		<section class="stripe" id="sobre-mi">
    <article>
        <h3>Sobre mí</h3>
        <p>
            Soy Cristhian Rocha, desarrollador full stack de Cochabamba, Bolivia. 
            Apasionado por transformar ideas en productos digitales funcionales y escalables.
            Disfruto trabajar en equipos ágiles y resolver problemas complejos.
        </p>
    </article>
    <article>
        <h3>¿Qué construyo?</h3>
        <p>
            Desde sistemas de gestión para clínicas y comercios hasta aplicaciones móviles 
            con React Native. Mi objetivo es siempre el mismo: crear herramientas que 
            optimicen procesos y generen valor real para el negocio.
        </p>
    </article>
</section>

	<section class="block" id="experiencia">
    <div class="section-header">
        <h2>Experiencia profesional</h2>
        <p class="section-subtitle">
            2+ años construyendo producto real para clientes en Bolivia y EE.UU.
        </p>
    </div>

    <div class="experience-grid">
        {experience.map((job) => (
            <div class="job-card" data-expanded="false">
                <button 
                    class="job-toggle" 
                    aria-expanded="false"
                    aria-controls={`job-content-${job.id}`}
                    id={`job-toggle-${job.id}`}
                    type="button"
                >
                    <div class="job-header">
                        <div class="job-meta">
                            <span class="job-period">{job.period}</span>
                            {job.isHighlight && (
                                <span class="job-badge">🎯 Logro destacado</span>
                            )}
                        </div>
                        <h3 class="job-title">
                            {job.role} · {job.company}
                            <span class="job-place">{job.place}</span>
                        </h3>
                    </div>
                    <div class="job-toggle-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </button>
				{job.url && (
					<div class="job-links">
						<a href={job.url} target="_blank" rel="noopener noreferrer">
							Visitar sitio web
				
						</a>
					</div>
				)}

                <div 
                    class="job-content" 
                    id={`job-content-${job.id}`}
                    role="region"
                    aria-labelledby={`job-toggle-${job.id}`}
                >
                    <ul class="job-points">
                        {job.points.map((point) => (
                            <li>{point}</li>
                        ))}
                    </ul>

                    {job.achievement && (
                        <div class="job-achievement">
                            <span class="achievement-icon">🚀</span>
                            <div>
                                <span class="achievement-label">Logro:</span>
                                <span class="achievement-text">{job.achievement}</span>
                            </div>
                        </div>
                    )}

                    <div class="job-tech">
                        {job.tech.map((tech) => (
                            <span class="tech-tag">{tech}</span>
                        ))}
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>

		<section class="block" id="stack">
			<h2>Stack principal</h2>
			<div class="tech">
				{stack.map((item) => (
					<span>
						{item.Icon && <item.Icon size={24} />}
						{item.name}
					</span>
				))}
			</div>
		</section>

		<section class="block" id="proyectos">
			<h2>Casos destacados</h2>
			<div class="projects">
				{projects.map((project, i) => (
					<article class="card" style={`--delay:${i * 120}ms`}>
						<p class="index">0{i + 1}</p>
						<h3>{project.title}</h3>
						<p>{project.description}</p>
						<p class="impact"><b>Logro:</b> {project.result}</p>
						<ul class="tags">
							{project.tags.map((tag) => <li>{tag}</li>)}
						</ul>
						<div class="card-links">
							<a href={project.demo} target="_blank" rel="noopener noreferrer">Ver demo →</a>
							<a href={project.repo} target="_blank" rel="noopener noreferrer">Código →</a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="cta" id="contacto">
			<h2>¿Buscas un perfil full stack para impulsar tu producto?</h2>
			<p>
				Cuéntame el contexto de tu proyecto y te propongo una ruta técnica clara.
			</p>
			<div class="actions">
				<a class="btn solid" href="mailto:rochacristhian77@gmail.com">Escribirme por email</a>
				<a class="btn outline" href="/cv-cristian.pdf" target="_blank" rel="noopener noreferrer">Descargar CV</a>
			</div>
		</section>
	</main>
</Layout>



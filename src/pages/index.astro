		tags: ['Next.js', 'Supabase', 'TypeScript', 'Tailwind'],
		demo: 'https://ssitema-de-gestion-veterinario.vercel.app/',
		repo: 'https://github.com/cristhian2020/Ssitema-de-Gestion-Veterinario',
		image: {
			src: '/projects/veterinaria/veterinaria-app.webp',
			alt: 'Sistema de Gestión Veterinaria',
			width: 600,
			height: 400
		}
	},
	{
		title: 'Landing Page Cafetería Santa Fe',
		description: 'Landing page de alta conversión para cafetería de especialidad con menú digital interactivo y canal directo de pedidos por WhatsApp.',
		result: 'Diseño moderno y responsivo enfocado en captación y experiencia de usuario.',
		tags: ['Astro', 'Tailwind', 'JavaScript'],
		demo: 'https://landing-page-cafeteria-seven.vercel.app/',
		repo: 'https://github.com/cristhian2020/LandingPageCafeteria',
		image: {
			src: '/projects/coffe/landing-coffe.webp',
			alt: 'Landing Page Cafetería Santa Fe',
			width: 600,
			height: 400
		}
	},
    {
		title: "Landing Page D'JASS MARKET",
		description: 'Landing page de alta conversión para una tienda de ropa con catálogo interactivo y integración directa con WhatsApp para consultas y pedidos.',
		result: 'Diseño moderno y responsivo enfocado en captación y experiencia de usuario.',
		tags: ['Astro', 'Tailwind', 'JavaScript'],
		demo: 'https://clothing-store-gamma-seven.vercel.app/',
		repo: 'https://github.com/cristhian2020/clothing-store',
		image: {
			src: '/projects/ropa/ropa-store.webp',
			alt: "Landing Page D'JASS MARKET",
			width: 600,
			height: 400
		}
	},
	
	{
		title: 'Sistema de Gestión Dental',
		description: 'Plataforma para clínica dental: historias clínicas, agenda de citas y pagos en un solo sistema.',
		result: 'Reducción del 40% en el tiempo administrativo de recepción.',
		tags: ['Next.js', 'Firebase'],
		repo: 'https://github.com/cristhian2020/Sistema_Dental_Clinico',
        image: {
            src: '/projects/odontologia/odontologia.webp',
            alt: 'Sistema de Gestión Dental',
            width: 600,
            height: 400
        }
	}
];
---

<Layout title="Cristhian Rocha | Full Stack & Mobile Developer">
	<div class="shell">
		<section class="hero" id="inicio">
			<div class="hero-copy">
				<p class="tag">FULL STACK & MOBILE DEVELOPER</p>
				<h1>Arquitectura, código y producto en una sola ejecución.</h1>
				<p>
					Construyo aplicaciones web y móviles reales para clínicas, comercios y
					sistemas universitarios. Especializado en React, Next.js y React Native:
					de la estrategia del MVP al despliegue en producción.
				</p>
				<div class="actions">
					<a class="btn solid" href="#proyectos">Explorar proyectos</a>
					<a class="btn outline" href="#contacto">Agendar llamada</a>
				</div>
			</div>

			<aside class="hero-panel">
				<p class="mini">Disponibilidad</p>
				<h2><span class="status-dot"></span> Inmediata</h2>
				<ul>
					<li>2+ años construyendo producto real para clientes.</li>
					<li>Web + mobile: React, Next.js y React Native.</li>
					<li>Cochabamba, Bolivia · Remoto · Inglés B1.</li>
				</ul>
			</aside>
		</section>

		<section class="stripe" id="sobre-mi">
    <article>
        <h3>Sobre mí</h3>
        <p>
            Soy Cristhian Rocha, desarrollador full stack de Cochabamba, Bolivia. 
            Apasionado por transformar ideas en productos digitales funcionales y escalables.
            Disfruto trabajar en equipos ágiles y resolver problemas complejos.
        </p>
    </article>
    <article>
        <h3>¿Qué construyo?</h3>
        <p>
            Desde sistemas de gestión para clínicas y comercios hasta aplicaciones móviles 
            con React Native. Mi objetivo es siempre el mismo: crear herramientas que 
            optimicen procesos y generen valor real para el negocio.
        </p>
    </article>
</section>

	<section class="block" id="experiencia">
    <div class="section-header">
        <h2>Experiencia profesional</h2>
        <p class="section-subtitle">
            2+ años construyendo producto real para clientes en Bolivia y EE.UU.
        </p>
    </div>

    <div class="experience-grid">
        {experience.map((job) => (
            <div class="job-card" data-expanded="false">
                <button 
                    class="job-toggle" 
                    aria-expanded="false"
                    aria-controls={`job-content-${job.id}`}
                    id={`job-toggle-${job.id}`}
                    type="button"
                >
                    <div class="job-header">
                        <div class="job-meta">
                            <span class="job-period">{job.period}</span>
                            {job.isHighlight && (
                                <span class="job-badge">🎯 Logro destacado</span>
                            )}
                        </div>
                        <h3 class="job-title">
                            {job.role} · {job.company}
                            <span class="job-place">{job.place}</span>
                        </h3>
                    </div>
                    <div class="job-toggle-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                </button>
				{job.url && (
					<div class="job-links">
						<a href={job.url} target="_blank" rel="noopener noreferrer">
							Visitar sitio web
				
						</a>
					</div>
				)}

                <div 
                    class="job-content" 
                    id={`job-content-${job.id}`}
                    role="region"
                    aria-labelledby={`job-toggle-${job.id}`}
                >
                    <ul class="job-points">
                        {job.points.map((point) => (
                            <li>{point}</li>
                        ))}
                    </ul>

                    {job.achievement && (
                        <div class="job-achievement">
                            <span class="achievement-icon">🚀</span>
                            <div>
                                <span class="achievement-label">Logro:</span>
                                <span class="achievement-text">{job.achievement}</span>
                            </div>
                        </div>
                    )}

                    <div class="job-tech">
                        {job.tech.map((tech) => (
                            <span class="tech-tag">{tech}</span>
                        ))}
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>

		<section class="block" id="stack">
			<h2>Stack principal</h2>
			<div class="tech">
				{stack.map((item) => (
					<span>
						{item.Icon && <item.Icon size={24} />}
						{item.name}
					</span>
				))}
			</div>
		</section>

		<section class="block" id="proyectos">
    <div class="section-header">
        <h2>Casos destacados</h2>
        <p class="section-subtitle">
            Proyectos reales que resuelven problemas concretos
        </p>
    </div>
    
    <div class="projects-grid">
        {projects.map((project, i) => (
            <article class="project-card" style={`--delay:${i * 120}ms`}>
                {/* Contenedor de imagen con overlay */}
                <div class="project-image-wrapper">
                    {project.image ? (
                        <img 
                            src={project.image.src} 
                            alt={project.image.alt || project.title}
                            width={project.image.width || 600}
                            height={project.image.height || 400}
                            loading="lazy"
                            class="project-image"
                        />
                    ) : (
                        <div class="project-image-placeholder">
                            <span>📸</span>
                            <span>Imagen próximamente</span>
                        </div>
                    )}
                    
                    {/* Overlay con tecnologías */}
                    <div class="project-overlay">
                        <div class="project-tags-overlay">
                            {project.tags.map((tag) => (
                                <span class="tag-overlay">{tag}</span>
                            ))}
                        </div>
                    </div>
                </div>

                {/* Contenido de la tarjeta */}
                <div class="project-content">
                    <p class="project-index">0{i + 1}</p>
                    <h3 class="project-title">{project.title}</h3>
                    <p class="project-description">{project.description}</p>
                    
                    {project.result && (
                        <p class="project-impact">
                            <span class="impact-icon">🚀</span>
                            {project.result}
                        </p>
                    )}

                    <div class="project-links">
                        {project.demo && (
                            <a href={project.demo} target="_blank" rel="noopener noreferrer" class="project-link">
                                Ver demo →
                            </a>
                        )}
                        {project.repo && (
                            <a href={project.repo} target="_blank" rel="noopener noreferrer" class="project-link">
                                Código →
                            </a>
                        )}
                    </div>
                </div>
            </article>
        ))}
    </div>
</section>

		<section class="cta" id="contacto">
			<h2>¿Buscas un perfil full stack para impulsar tu producto?</h2>
			<p>
				Cuéntame el contexto de tu proyecto y te propongo una ruta técnica clara.
			</p>
			<div class="actions">
				<a class="btn solid" href="mailto:rochacristhian77@gmail.com">Escribirme por email</a>
				<a class="btn whatsapp" href="https://wa.me/59162640539" target="_blank" rel="noopener noreferrer">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 0.35rem;">
						<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zM12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.98-1.306C8.423 21.493 10.153 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
					</svg>
					WhatsApp
				</a>
				<a class="btn outline" href="/Cristhian_Rocha_CV.pdf" download="Cristhian_Rocha_CV.pdf" target="_blank" rel="noopener noreferrer">Descargar CV</a>
			</div>
		</section>
	</div>
</Layout>



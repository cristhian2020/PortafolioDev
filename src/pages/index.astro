const projects = [
	{
		title: 'Landing Page Element Safety LLC',
		description: 'Landing page para empresa de construcción en EE.UU.',
		result: 'Mejor posicionamiento en buscadores y mayor visibilidad de la empresa.',
		tags: ['Astro', 'React', 'Tailwind'],
		demo: 'https://www.elementsafetyllc.com/',
		repo: 'https://github.com/cristhian2020/temporal-page',
		image: {
			src: '/projects/element-safety/safety1.webp',
			alt: 'Landing Page Element Safety LLC',
			width: 600,
			height: 400
		}
	},
	{
		title: 'Sistema de Gestión Veterinaria',
		description: 'Plataforma clínica para centros veterinarios: historias clínicas digitales, reservas de turnos online y atención de urgencias 24/7.',
